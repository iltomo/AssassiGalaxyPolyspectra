double WindowFunctions::DDWg2 (double x, void* param) {

	(void) (param); /* avoid unused parameter warning */

	gsl_function F;
	double res, err;

	F.function = &DWg2;
	F.params = 0;

	gsl_deriv_central (&F, x, 1e-8, &res, &err);
	return res;

}
