	(void) (param); /* avoid unused parameter warning */
	return (1. / sqrt (2. * M_PI) / sigmaChi) * exp ( - (x - Chiav) * (x - Chiav) / (2. * sigmaChi * sigmaChi) ) * DC * DC;

}

double WindowFunctions::DWg2 (double x, void* param) {

	(void) (param); /* avoid unused parameter warning */

	gsl_function F;
	double res, err;

	F.function = &Wg2;
	F.params = 0;

