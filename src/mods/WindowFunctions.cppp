#include "../include/WindowFunctions.h"
#include "../include/Cosmology.h"

#include <cmath>

WindowFunctions::WindowFunctions (std::string pfilein, int lin, double sigmaChiin, double Chiin, double Chiavin) {

	pfile = pfilein;
	l = lin;
	sigmaChi= sigmaChiin;
	Chi = Chiin;
	Chiav = Chiavin;

	GrowthFactor growth (pfile);
	DC = growth.DChi (Chi);

}

double WindowFunctions::Wg1 (double x, void* param) {

	(void) (param); /* avoid unused parameter warning */
	return (1. / sqrt (2. * M_PI) / sigmaChi) * exp ( - (x - Chiav) * (x - Chiav) / (2. * sigmaChi * sigmaChi) ) * DC;

}

double WindowFunctions::DWg1 (double x, void* param) {

	(void) (param); /* avoid unused parameter warning */

	gsl_function F;
	double res, err;

	F.function = &Wg1;
	F.params = 0;

	gsl_deriv_central (&F, x, 1e-8, &res, &err);
	return res;

}

double WindowFunctions::DDWg1 (double x, void* param) {

	(void) (param); /* avoid unused parameter warning */

	gsl_function F;
	double res, err;

	F.function = &DWg1;
	F.params = 0;

	gsl_deriv_central (&F, x, 1e-8, &res, &err);
	return res;

}

double WindowFunctions::DDDWg1 (double x, void* param) {

	(void) (param); /* avoid unused parameter warning */

	gsl_function F;
	double res, err;

	F.function = &DDWg1;
	F.params = 0;

	gsl_deriv_central (&F, x, 1e-8, &res, &err);
	return res;

}


