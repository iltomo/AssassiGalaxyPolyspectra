// ----- Window Functions class ----- //

WindowFunctions::WindowFunctions (std::string pfile, int ell, double sc, double c, double cav):GrowthFactor (pfile) {

	l = ell;
	sigmaChi = sc;
	Chi = c;
	Chiav = cav;
	DC = DChi (Chi);
}


// ----- GalaxyClustering class  ----- //

struct DeriveFuncparams {gsl_function func;};

// ----- Derive Function f using GSL ----- //
double DeriveFunc (double x, void* param) {

	struct DeriveFuncparams *par = (struct DeriveFuncparams *) param;

	gsl_function f = (par -> func);
	double res, err;

	//gsl_deriv_central (&f, x, 1e-8, &res, &err);

	res = (GSL_FN_EVAL (&f, x + 1e-8) - GSL_FN_EVAL (&f, x - 1e-8)) / 2e-8;

	return res;
}
double DeriveFunc2 (double x, void* param) {

	struct DeriveFuncparams *par = (struct DeriveFuncparams *) param;

	gsl_function f = (par -> func);
	double res, err;

	//res = (GSL_FN_EVAL (&f, x + 2e-8) + GSL_FN_EVAL (&f, x - 2e-8) - 2.*GSL_FN_EVAL (&f, x)) / 2e-8 / 2e-8;

	res = (DeriveFunc (x + 1e-8, param) - DeriveFunc (x - 1e-8, param) ) / 2e-8;

	return res;
}
double DeriveFunc3 (double x, void* param) {

	struct DeriveFuncparams *par = (struct DeriveFuncparams *) param;

	gsl_function f = (par -> func);
	double res, err;

	res = (GSL_FN_EVAL (&f, x + 3e-8) + GSL_FN_EVAL (&f, x - 3e-8) - 2.*GSL_FN_EVAL (&f, x-1e-8)) / 2e-8 / 2e-8 / 2e-8;

	return res;
}

